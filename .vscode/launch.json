{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Containers: Attach to Node, separate containers",
            "remoteRoot": "/heatLossApp/backend",
            "port": 9229,
            "address": "localhost",
            "localRoot": "${workspaceFolder}/backend",
            "restart": true
        },
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend/src"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend/src"
        },
        {
            "name": "backend: npm run dev", // Give your task a name
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev", // Enter the command to run,
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "name": "launch client", // Give your task a name
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000" // Enter the URL it will be on
        },
        {
            "name": "start server, open chrome, 1",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "serverReadyAction": {
                "pattern": "server started\\. Go to (https?://.+)",
                "uriFormat": "%s",
                "action": "debugWithChrome"
            }
        },
        {
            "name": "start server, open chrome, 2",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run debug",
            "cwd": "${workspaceFolder}",
            "serverReadyAction": {
                "pattern": "server started\\. Go to (https?://.+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Attach to Chrome on port 9222",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "start server, open chrome, 3",
            "configurations": [
                "backend: npm run dev",
                "launch client",
            ],
            "stopAll": true
        }
    ]
}